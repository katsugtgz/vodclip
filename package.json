{
  "name": "vodclip",
  "version": "0.2.0",
  "description": "Cut a timestamped clip from a Twitch or Kick VOD. One command, no account, minimal deps (uses yt-dlp).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vodclip": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "lib.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "twitch",
    "kick",
    "vod",
    "clip",
    "downloader",
    "yt-dlp",
    "timestamp"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "dry-run": "node cli.mjs \"https://www.twitch.tv/videos/2883843627\" 0:00:00 30 --dry-run",
    "test:pipeline": "bun test pipeline/",
    "pipeline": "bun pipeline/run.ts",
    "queue": "bun pipeline/queue.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2"
  }
}